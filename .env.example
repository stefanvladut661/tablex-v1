# Supabase Configuration
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=your-project-id

# Claude API (for autonomous Oracle server)
# Get this from: https://console.anthropic.com/keys
CLAUDE_API_KEY=sk-ant-v0-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────
# Secretele Edge Function-ului `trimite-email` — NU sunt variabile Vite.
# Nu se pun in .env.local: se seteaza pe proiectul Supabase, cu
#   supabase secrets set NUME=valoare
#
# Fara RESEND_API_KEY functia ruleaza in mod SIMULAT: raspunde 200, logheaza ce
# ar fi trimis, iar aplicatia cade elegant pe "copiaza linkul" la invitatii.
# Deci aplicatia e complet functionala si fara furnizor de email.
#
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#   EMAIL_EXPEDITOR=TableX <rezervari@domeniul-tau.ro>
#   URL_APLICATIE=https://app.tablex.ro
#
# EMAIL_EXPEDITOR trebuie sa fie pe un domeniu verificat la furnizor, altfel
# emailurile sunt respinse. URL_APLICATIE intra in linkurile din email.
# ─────────────────────────────────────────────────────────────────────────
