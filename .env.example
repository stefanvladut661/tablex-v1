# Supabase Configuration
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=your-project-id

# Claude API (for autonomous Oracle server)
# Get this from: https://console.anthropic.com/keys
CLAUDE_API_KEY=sk-ant-v0-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────
# Secretele Edge Function-ului `trimite-email` — NU sunt variabile Vite.
# Nu se pun in .env.local: se seteaza pe proiectul Supabase, cu
#   supabase secrets set NUME=valoare
#
# Fara RESEND_API_KEY functia ruleaza in mod SIMULAT: raspunde 200, logheaza ce
# ar fi trimis, iar aplicatia cade elegant pe "copiaza linkul" la invitatii.
# Deci aplicatia e complet functionala si fara furnizor de email.
#
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#   EMAIL_EXPEDITOR=TableX <rezervari@domeniul-tau.ro>
#   URL_APLICATIE=https://app.tablex.ro
#
# EMAIL_EXPEDITOR trebuie sa fie pe un domeniu verificat la furnizor, altfel
# emailurile sunt respinse. URL_APLICATIE intra in linkurile din email.
# ─────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────
# Emailul "am primit cererea ta", trimis clientului widgetului (migratia 16).
# Clientul e anonim si prin RLS nu-si poate citi rezervarea, deci apelul nu
# poate porni din browser: il porneste baza de date, printr-un trigger pg_net.
#
# Trigger-ul isi ia configurarea din Supabase Vault, NU din .env. Trei secrete,
# create o singura data pe proiect (SQL editor sau MCP):
#
#   select vault.create_secret(
#     'https://<proiect>.supabase.co/functions/v1', 'tablex_url_functii');
#   select vault.create_secret(
#     '<cheia anon>', 'tablex_cheie_anon');
#   select vault.create_secret(
#     encode(extensions.gen_random_bytes(32), 'hex'), 'tablex_secret_webhook');
#
# - tablex_cheie_anon e cheia publica din bundle: trece doar de verify_jwt al
#   platformei, nu da acces la date.
# - tablex_secret_webhook e generat in baza si nu pleaca nicaieri; Edge
#   Function-ul il valideaza inapoi prin RPC-ul verifica_secret_webhook.
#   Rotirea lui = un simplu vault.update_secret, fara redesfasurarea functiei.
# - Daca oricare lipseste, trigger-ul iese in tacere: rezervarile merg mai
#   departe, doar emailul de primire nu pleaca.
# ─────────────────────────────────────────────────────────────────────────
